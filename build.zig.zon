.{
    .name = .zig_starter,
    .version = "0.1.1",
    .fingerprint = 0x33d265d3b098d49d, // Changing this has security and trust implications.
    .minimum_zig_version = "0.17.0-dev.1857",

    // Dependencies come from the pantry registry as tarballs with a hash, never as relative paths,
    // so a fresh clone builds without sibling checkouts. Example:
    //
    //   .regex = .{
    //       .url = "https://registry.pantry.dev/zig/packages/zig-regex/0.2.1/tarball",
    //       .hash = "zig_regex-0.2.1-omky0ZgdGQA1p3_ZDMPQ2PxIxqVzXZH8NhVTeHal08R3",
    //   },
    //
    // `zig fetch --save <url>` writes the entry and its hash for you.
    .dependencies = .{
        .bench = .{
            .lazy = true,
            .url = "https://registry.pantry.dev/zig/packages/zig-bench/0.2.1/tarball",
            .hash = "zig_bench-0.2.1-FoCM--g7AwBKI7pKOE_UBYMOONDqfGQr-pR8nTpwf7vw",
        },
    },

    .paths = .{
        "build.zig",
        "build.zig.zon",
        "include",
        "src",
        "LICENSE",
        "README.md",
    },
}
